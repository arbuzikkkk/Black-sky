# Copy this file to `.env` and fill in real values.
# .env is loaded at runtime via flutter_dotenv and is listed in pubspec assets.
# NEVER commit the real .env file — keep it in .gitignore.

# --- Nakama dedicated server (you host this yourself; Termux cannot run it) ---
NAKAMA_HOST=127.0.0.1
NAKAMA_PORT=7350
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_USE_SSL=false

# --- Firebase (values come from google-services.json / Firebase console) ---
FIREBASE_PROJECT_ID=black-sky-rts
